{
	"compatibility_date": "2026-06-02",
	"compatibility_flags": ["nodejs_compat"],
	"name": "jessicaestalella-comunidad",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// ⚠️ `./dist/client`, NO `./dist`. El adapter de Astro deja el bundle del
	// servidor y `dist/server/.dev.vars` (con DATABASE_URL, BETTER_AUTH_SECRET,
	// RESEND_API_KEY…) dentro de `dist/`. Workers Assets sube TODO el directorio
	// recursivamente, sin excluir dotfiles: apuntar a `./dist` publicaría los
	// secretos en `https://<dominio>/server/.dev.vars`.
	// `npm run deploy` corre el build antes y el adapter regenera un redirect que
	// corrige esto, pero un `wrangler deploy` suelto (CI, checkout limpio sin
	// `.wrangler/`) usa ESTE archivo. Tiene que ser correcto por sí mismo.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// ── Entornos ───────────────────────────────────────────────────────────────
	// El entorno de pruebas es un Worker aparte, servido en
	// `capitanabsas.dev.jessicaestalella.com`. Apunta al branch de dev de Neon:
	// probar contra la base real significa mandarle mails a personas reales.
	//
	// Deploy:  npx wrangler deploy --env staging   (después de `astro build`)
	//
	// ⚠️ `assets` se repite a propósito: los entornos con nombre no heredan los
	// bindings del bloque de arriba, y si falta, el Worker de pruebas se sube
	// sin los archivos estáticos.
	//
	// Secretos por entorno: wrangler secret put <NOMBRE> --env staging
	// En dev, COOKIE_DOMAIN=.dev.jessicaestalella.com y COOKIE_PREFIX=dev-jessica
	// (idéntico al de cursos, o se rompe el SSO).
	"env": {
		"staging": {
			"name": "jessicaestalella-comunidad-staging",
			"assets": {
				"directory": "./dist/client",
				"binding": "ASSETS"
			},
			"observability": {
				"enabled": true
			}
		}
	}
	// Secretos (DATABASE_URL, BETTER_AUTH_SECRET, RESEND_API_KEY) NUNCA acá.
	// En prod: wrangler secret put <NOMBRE>
}
