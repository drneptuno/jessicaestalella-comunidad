# ─── Base de datos (Neon / Postgres) ───────────────────────────────
# ⚠️ BASE COMPARTIDA con `jessicaestalella-cursos`: debe ser EXACTAMENTE la
# misma connection string que usa ese repo. La cuenta única y el SSO dependen
# de que ambas apps lean las mismas tablas de auth.
# Solo servidor. En prod: wrangler secret put DATABASE_URL
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ─── Better Auth ───────────────────────────────────────────────────
# ⚠️ DEBE SER EL MISMO VALOR que en `cursos`: la cookie de sesión se firma con
# este secreto, y si difieren cada app rechaza la sesión de la otra.
# Generar una sola vez con: openssl rand -base64 32
# En prod: wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=
# URL base de la app (para callbacks / magic links)
BETTER_AUTH_URL=http://localhost:4321

# ─── Email TRANSACCIONAL (Resend) ──────────────────────────────────
# El enlace de acceso (magic link). Solo servidor.
# En prod: wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@jessicaestalella.com

# ─── Marketing / automatizaciones (MailerLite) ─────────────────────
# Al entrar a la comunidad, la miembra se suma a este grupo y corren las
# automatizaciones de Jessica. Opcional: sin key, se saltea sin romper nada.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# ─── URLs públicas (van al cliente, prefijo PUBLIC_) ───────────────
# Dev: http://localhost:4321 · Prod: https://capitanabsas.jessicaestalella.com
PUBLIC_SITE_URL=http://localhost:4321

# ─── SSO entre subdominios ─────────────────────────────────────────
# Dominio padre donde se emite la cookie de sesión, para que viaje entre
# cursos.* y capitanabsas.*. DEJAR VACÍO EN LOCAL: localhost no acepta cookies
# de dominio padre, y en dev cada app corre en su propio puerto.
# Prod: .jessicaestalella.com   (con el punto inicial)
COOKIE_DOMAIN=
# App hermana (origen confiable + links de "ver la membresía")
COURSES_URL=http://localhost:3004

# ─── Vista previa (SOLO desarrollo) ────────────────────────────────
# 'true' saltea el login e inyecta una usuaria ficticia para recorrer todo.
# Se ignora por completo en el build de producción. NUNCA usar en prod.
# Combinar con `npm run seed:demo` para tener datos de ejemplo.
PREVIEW_BYPASS_AUTH=
